{
  "name": "canofold-vscode",
  "displayName": "Canofold Markdown Preview",
  "description": "Preview Markdown with Canofold in the current VS Code editor tab.",
  "version": "0.1.15",
  "packageManager": "pnpm@11.9.0",
  "publisher": "canofold",
  "icon": "media/canofold.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/canofold/vscode.git"
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "markdown",
    "preview",
    "canofold"
  ],
  "extensionKind": [
    "workspace"
  ],
  "main": "./dist/extension.cjs",
  "activationEvents": [
    "onCommand:canofold.toggle",
    "onCommand:canofold.preview",
    "onCommand:canofold.source",
    "onCustomEditor:canofold.markdownPreview"
  ],
  "contributes": {
    "commands": [
      {
        "command": "canofold.toggle",
        "title": "Toggle Canofold Preview",
        "category": "Canofold",
        "icon": {
          "light": "media/canofold.png",
          "dark": "media/canofold.png"
        }
      },
      {
        "command": "canofold.preview",
        "title": "Preview with Canofold",
        "category": "Canofold",
        "icon": "$(book)"
      },
      {
        "command": "canofold.source",
        "title": "Edit Markdown Source",
        "category": "Canofold",
        "icon": "$(go-to-file)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "canofold.toggle",
          "when": "(resourceExtname =~ /^\\.md$/i && !notebookEditorFocused) || activeCustomEditorId == 'canofold.markdownPreview'",
          "group": "navigation@10"
        }
      ]
    },
    "customEditors": [
      {
        "viewType": "canofold.markdownPreview",
        "displayName": "Canofold Preview",
        "selector": [
          {
            "filenamePattern": "*.md"
          }
        ],
        "priority": "option"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "pnpm build",
    "build": "pnpm typecheck && node scripts/build.mjs",
    "test": "pnpm build && node scripts/test.mjs",
    "test:editor": "pnpm build && node scripts/test-editor.mjs",
    "typecheck": "tsc --noEmit",
    "watch": "node scripts/build.mjs --watch",
    "package": "pnpm dlx @vscode/vsce@3.9.2 package --no-dependencies"
  },
  "dependencies": {
    "@canofold/markdown": "0.7.0",
    "@canofold/plugins": "0.7.0",
    "@canofold/themes": "0.7.0",
    "@plantuml/core": "1.2026.8",
    "@terrastruct/d2": "0.1.33",
    "@viz-js/viz": "3.31.0",
    "css-tree": "^3.2.1",
    "mermaid": "12.2.0",
    "parse-srcset": "^1.0.2",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/css-tree": "^3.2.0",
    "@types/node": "^22.20.3",
    "@types/parse-srcset": "^1.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/vscode": "^1.100.0",
    "esbuild": "^0.25.12",
    "typescript": "^6.0.3"
  }
}
